      <aliases enabled='yes' />
      <column caption='Adjusted Close' datatype='real' name='[AdjustedClose]' role='measure' type='quantitative' />
      <column caption='Asset Type' datatype='string' name='[AssetType]' role='dimension' type='nominal' />
      <column caption='Indexed Performance' datatype='real' name='[Calculation_0691640279662592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([AdjustedClose])&#13;&#10;/&#13;&#10;LOOKUP(&#13;&#10;    AVG([AdjustedClose]),&#13;&#10;    FIRST()&#13;&#10;)&#13;&#10;* 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Daily Return' datatype='real' name='[Calculation_0691640281989122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([AdjustedClose])&#13;&#10;/&#13;&#10;LOOKUP(&#13;&#10;    AVG([AdjustedClose]),&#13;&#10;    -1&#13;&#10;)&#13;&#10;- 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Annualized Volatility' datatype='real' name='[Calculation_0691640283185158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF INDEX() &gt;= 31 THEN&#13;&#10;&#13;&#10;    WINDOW_STDEV(&#13;&#10;        AVG([AdjustedClose])&#13;&#10;        /&#13;&#10;        LOOKUP(&#13;&#10;            AVG([AdjustedClose]),&#13;&#10;            -1&#13;&#10;        )&#13;&#10;        - 1,&#13;&#10;        -29,&#13;&#10;        0&#13;&#10;    )&#13;&#10;    *&#13;&#10;    SQRT(252)&#13;&#10;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Drawdown' datatype='real' name='[Calculation_0691640286019591]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([AdjustedClose])&#13;&#10;/&#13;&#10;RUNNING_MAX(&#13;&#10;    AVG([AdjustedClose])&#13;&#10;)&#13;&#10;- 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Maximum Drawdown' datatype='real' name='[Calculation_0691640286760968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MIN(&#13;&#10;    AVG([AdjustedClose])&#13;&#10;    /&#13;&#10;    RUNNING_MAX(&#13;&#10;        AVG([AdjustedClose])&#13;&#10;    )&#13;&#10;    - 1&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Show Last Mark' datatype='boolean' name='[Calculation_0691640287944713]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() = 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CAGR' datatype='real' name='[Calculation_0691640290312203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='POWER(&#13;&#10;    AVG([AdjustedClose])&#13;&#10;    /&#13;&#10;    LOOKUP(&#13;&#10;        AVG([AdjustedClose]),&#13;&#10;        FIRST()&#13;&#10;    ),&#13;&#10;    365.25&#13;&#10;    /&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;day&apos;,&#13;&#10;        LOOKUP(&#13;&#10;            MIN([TradeDate]),&#13;&#10;            FIRST()&#13;&#10;        ),&#13;&#10;        MIN([TradeDate])&#13;&#10;    )&#13;&#10;)&#13;&#10;- 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Full Period Annualized Volatility' datatype='real' name='[Calculation_0691640291008524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_STDEV(&#13;&#10;    AVG([AdjustedClose])&#13;&#10;    /&#13;&#10;    LOOKUP(&#13;&#10;        AVG([AdjustedClose]),&#13;&#10;        -1&#13;&#10;    )&#13;&#10;    - 1&#13;&#10;)&#13;&#10;*&#13;&#10;SQRT(252)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SPY Adjusted Close' datatype='real' name='[Calculation_0691640294486029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [TradeDate] :&#13;&#10;    MAX(&#13;&#10;        IF [Symbol] = &quot;SPY&quot;&#13;&#10;        THEN [AdjustedClose]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Relative Performance vs SPY' datatype='real' name='[Calculation_0691640294645774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    AVG([AdjustedClose])&#13;&#10;    /&#13;&#10;    LOOKUP(&#13;&#10;        AVG([AdjustedClose]),&#13;&#10;        FIRST()&#13;&#10;    )&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;    AVG([Calculation_0691640294486029])&#13;&#10;    /&#13;&#10;    LOOKUP(&#13;&#10;        AVG([Calculation_0691640294486029]),&#13;&#10;        FIRST()&#13;&#10;    )&#13;&#10;)&#13;&#10;- 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sector Display' datatype='string' name='[Calculation_0691640309207056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Symbol] = &quot;SPY&quot; THEN&#13;&#10;    &quot;Benchmark&quot;&#13;&#10;ELSEIF ISNULL([Sector]) THEN&#13;&#10;    &quot;Other&quot;&#13;&#10;ELSE&#13;&#10;    [Sector]&#13;&#10;END' />
      </column>
      <column caption='First Trade Date' datatype='date' name='[Calculation_0691640310960145]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Symbol] : MIN([TradeDate]) }' />
      </column>
      <column caption='Last Trade Date' datatype='date' name='[Calculation_0691640311021586]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Symbol] : MAX([TradeDate]) }' />
      </column>
      <column caption='First Adjusted Close' datatype='real' name='[Calculation_0691640311054355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Symbol] :&#13;&#10;    MAX(&#13;&#10;        IF [TradeDate] = [Calculation_0691640310960145]&#13;&#10;        THEN [AdjustedClose]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Last Adjusted Close' datatype='real' name='[Calculation_0691640311095316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Symbol] :&#13;&#10;    MAX(&#13;&#10;        IF [TradeDate] = [Calculation_0691640311021586]&#13;&#10;        THEN [AdjustedClose]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='CAGR - Full Period' datatype='real' name='[Calculation_0691640311132181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='POWER(&#13;&#10;    [Calculation_0691640311095316] / [Calculation_0691640311054355],&#13;&#10;    365.25 /&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;day&apos;,&#13;&#10;        [Calculation_0691640310960145],&#13;&#10;        [Calculation_0691640311021586]&#13;&#10;    )&#13;&#10;)&#13;&#10;- 1' />
      </column>
