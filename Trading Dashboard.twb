    <worksheet name='04 - Rolling Volatility'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000'>30-Day Rolling Volatility</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='HistoricalPrices (market_analytics_tableau)' name='federated.1jch9lb1i02c4d1cy5hu0048z8uv' />
          </datasources>
          <datasource-dependencies datasource='federated.1jch9lb1i02c4d1cy5hu0048z8uv'>
            <column caption='Adjusted Close' datatype='real' name='[AdjustedClose]' role='measure' type='quantitative' />
            <column caption='Annualized Volatility' datatype='real' name='[Calculation_0691640283185158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF INDEX() &gt;= 31 THEN&#13;&#10;&#13;&#10;    WINDOW_STDEV(&#13;&#10;        AVG([AdjustedClose])&#13;&#10;        /&#13;&#10;        LOOKUP(&#13;&#10;            AVG([AdjustedClose]),&#13;&#10;            -1&#13;&#10;        )&#13;&#10;        - 1,&#13;&#10;        -29,&#13;&#10;        0&#13;&#10;    )&#13;&#10;    *&#13;&#10;    SQRT(252)&#13;&#10;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Company Name' datatype='string' name='[CompanyName]' role='dimension' type='nominal' />
            <column datatype='string' name='[Symbol]' role='dimension' type='nominal' />
            <column caption='Trade Date' datatype='date' name='[TradeDate]' role='dimension' type='ordinal' />
            <column-instance column='[CompanyName]' derivation='None' name='[none:CompanyName:nk]' pivot='key' type='nominal' />
            <column-instance column='[Symbol]' derivation='None' name='[none:Symbol:nk]' pivot='key' type='nominal' />
            <column-instance column='[TradeDate]' derivation='None' name='[none:TradeDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0691640283185158]' derivation='User' name='[usr:Calculation_0691640283185158:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1jch9lb1i02c4d1cy5hu0048z8uv].[none:TradeDate:qk]' ordering-type='Field' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1jch9lb1i02c4d1cy5hu0048z8uv].[none:Symbol:nk]' filter-group='3'>
            <groupfilter function='member' level='[none:Symbol:nk]' member='&quot;BAC&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1jch9lb1i02c4d1cy5hu0048z8uv].[none:Symbol:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
