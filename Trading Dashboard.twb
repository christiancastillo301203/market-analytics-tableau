    <worksheet name='09 - Risk vs Return'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Risk vs Return</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' italic='true'>Annualized return (CAGR) vs annualized volatility</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='HistoricalPrices (market_analytics_tableau)' name='federated.1jch9lb1i02c4d1cy5hu0048z8uv' />
          </datasources>
          <datasource-dependencies datasource='federated.1jch9lb1i02c4d1cy5hu0048z8uv'>
            <column caption='Adjusted Close' datatype='real' name='[AdjustedClose]' role='measure' type='quantitative' />
            <column caption='Maximum Drawdown' datatype='real' name='[Calculation_0691640286760968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_MIN(&#13;&#10;    AVG([AdjustedClose])&#13;&#10;    /&#13;&#10;    RUNNING_MAX(&#13;&#10;        AVG([AdjustedClose])&#13;&#10;    )&#13;&#10;    - 1&#13;&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Show Last Mark' datatype='boolean' name='[Calculation_0691640287944713]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CAGR' datatype='real' name='[Calculation_0691640290312203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='POWER(&#13;&#10;    AVG([AdjustedClose])&#13;&#10;    /&#13;&#10;    LOOKUP(&#13;&#10;        AVG([AdjustedClose]),&#13;&#10;        FIRST()&#13;&#10;    ),&#13;&#10;    365.25&#13;&#10;    /&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;day&apos;,&#13;&#10;        LOOKUP(&#13;&#10;            MIN([TradeDate]),&#13;&#10;            FIRST()&#13;&#10;        ),&#13;&#10;        MIN([TradeDate])&#13;&#10;    )&#13;&#10;)&#13;&#10;- 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Full Period Annualized Volatility' datatype='real' name='[Calculation_0691640291008524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_STDEV(&#13;&#10;    AVG([AdjustedClose])&#13;&#10;    /&#13;&#10;    LOOKUP(&#13;&#10;        AVG([AdjustedClose]),&#13;&#10;        -1&#13;&#10;    )&#13;&#10;    - 1&#13;&#10;)&#13;&#10;*&#13;&#10;SQRT(252)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Company Name' datatype='string' name='[CompanyName]' role='dimension' type='nominal' />
            <column datatype='string' name='[Sector]' role='dimension' type='nominal' />
            <column datatype='string' name='[Symbol]' role='dimension' type='nominal' />
            <column caption='Trade Date' datatype='date' name='[TradeDate]' role='dimension' type='ordinal' />
            <column-instance column='[CompanyName]' derivation='Attribute' name='[attr:CompanyName:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sector]' derivation='Attribute' name='[attr:Sector:nk]' pivot='key' type='nominal' />
            <column-instance column='[Symbol]' derivation='None' name='[none:Symbol:nk]' pivot='key' type='nominal' />
            <column-instance column='[TradeDate]' derivation='None' name='[none:TradeDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0691640286760968]' derivation='User' name='[usr:Calculation_0691640286760968:qk:7]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1jch9lb1i02c4d1cy5hu0048z8uv].[TradeDate]' ordering-type='Field' />
            </column-instance>
