    <worksheet name='07 - CAGR'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>CAGR — Compound Annual Growth Rate</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' italic='true'>Annualized compounded return over the selected period</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='HistoricalPrices (market_analytics_tableau)' name='federated.1jch9lb1i02c4d1cy5hu0048z8uv' />
          </datasources>
          <datasource-dependencies datasource='federated.1jch9lb1i02c4d1cy5hu0048z8uv'>
            <column caption='Adjusted Close' datatype='real' name='[AdjustedClose]' role='measure' type='quantitative' />
            <column caption='Show Last Mark' datatype='boolean' name='[Calculation_0691640287944713]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CAGR' datatype='real' name='[Calculation_0691640290312203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='POWER(&#13;&#10;    AVG([AdjustedClose])&#13;&#10;    /&#13;&#10;    LOOKUP(&#13;&#10;        AVG([AdjustedClose]),&#13;&#10;        FIRST()&#13;&#10;    ),&#13;&#10;    365.25&#13;&#10;    /&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;day&apos;,&#13;&#10;        LOOKUP(&#13;&#10;            MIN([TradeDate]),&#13;&#10;            FIRST()&#13;&#10;        ),&#13;&#10;        MIN([TradeDate])&#13;&#10;    )&#13;&#10;)&#13;&#10;- 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Symbol]' role='dimension' type='nominal' />
            <column caption='Trade Date' datatype='date' name='[TradeDate]' role='dimension' type='ordinal' />
            <column-instance column='[Symbol]' derivation='None' name='[none:Symbol:nk]' pivot='key' type='nominal' />
            <column-instance column='[TradeDate]' derivation='None' name='[none:TradeDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0691640287944713]' derivation='User' name='[usr:Calculation_0691640287944713:nk:4]' pivot='key' type='nominal'>
              <table-calc ordering-field='[federated.1jch9lb1i02c4d1cy5hu0048z8uv].[TradeDate]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_0691640290312203]' derivation='User' name='[usr:Calculation_0691640290312203:qk:4]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1jch9lb1i02c4d1cy5hu0048z8uv].[TradeDate]' ordering-type='Field' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1jch9lb1i02c4d1cy5hu0048z8uv].[none:Symbol:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Symbol:nk]' member='&quot;AAPL&quot;' />
              <groupfilter function='member' level='[none:Symbol:nk]' member='&quot;JPM&quot;' />
              <groupfilter function='member' level='[none:Symbol:nk]' member='&quot;MSFT&quot;' />
              <groupfilter function='member' level='[none:Symbol:nk]' member='&quot;SPY&quot;' />
